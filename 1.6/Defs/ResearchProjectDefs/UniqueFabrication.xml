<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ResearchProjectDef>
    <defName>UniqueFabrication</defName>
    <label>unique fabrication</label>
    <description>Upgrade and customize spacer and ultratech weapons at a fabrication bench, adding or removing traits to suit your needs.</description>
    <baseCost>2000</baseCost>
    <techLevel>Spacer</techLevel>
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <requiredResearchFacilities>
      <li>MultiAnalyzer</li>
    </requiredResearchFacilities>
    <prerequisites>
      <li>UniqueMachining</li>
      <li>Fabrication</li>
    </prerequisites>
    <!-- Techprint fields (techprintCount/Commonality/MarketValue + heldByFactionCategoryTags)
         are a Royalty-only game system and live in Patches/UniqueFabrication_Royalty.xml so they
         only apply when Royalty is active. See that file for the rationale. -->
    <researchViewX>20.00</researchViewX>
    <researchViewY>5.40</researchViewY>
    <customUnlockTexts>
      <li>Upgrade and customize spacer weapons</li>
      <li>Upgrade and customize ultratech weapons</li>
    </customUnlockTexts>
    <generalRules>
      <rulesStrings>
        <li>subject->unique fabrication</li>
        <li>subject_story->decoded the secrets of modifying pulse-charged and beam weapon traits</li>
        <li>subject_story->used fabrication nanotechnology to alter spacer weapon components</li>
        <li>subject_gerund->fabricating unique weapons</li>
      </rulesStrings>
    </generalRules>
  </ResearchProjectDef>

</Defs>